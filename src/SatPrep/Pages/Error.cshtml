@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="card p-4">
    <h1 class="h4 text-danger">Something went wrong</h1>
    <p class="mb-2">The error has been logged. Go back and try again, or return to the home page.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-3">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" href="/">Home</a>
</div>
