@page
@model MistakesModel
@{
    ViewData["Title"] = "Mistakes";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Mistakes</h1>
        <p class="text-muted mb-0">Every question you last got wrong. Misses come back automatically after 1, 3 and 7 days until you get them right.</p>
    </div>
    <div>
        @if (Model.DueNow > 0)
        {
            <a class="btn btn-warning" href="/Practice?mode=ReviewDue">Review @Model.DueNow due now</a>
        }
        <a class="btn btn-primary" href="/Practice?mode=Incorrect@(Model.Domain is int d ? "&domain=" + d : "")">Retry all</a>
    </div>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="d-flex flex-wrap gap-2 filter-bar">
        <select class="form-select w-auto" name="domain" onchange="this.form.submit()">
            <option value="">All domains</option>
            @foreach (var d in Model.Domains)
            {
                <option value="@d.Id" selected="@(Model.Domain == d.Id)">@d.Name</option>
            }
        </select>
        <select class="form-select w-auto" name="difficulty" onchange="this.form.submit()">
            <option value="">All difficulties</option>
            @foreach (var d in Enum.GetValues<Difficulty>())
            {
                <option selected="@(Model.Difficulty == d)">@d</option>
            }
        </select>
        <span class="ms-auto align-self-center small text-muted">@Model.Rows.Count question@(Model.Rows.Count == 1 ? "" : "s")</span>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="card p-4 text-center text-muted">No mistakes here. Keep practising!</div>
}
else
{
    <div class="card p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Question</th><th>Skill</th><th></th><th class="text-nowrap">Your answer</th><th>Next review</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="small" style="max-width:380px">@r.Preview</td>
                            <td class="small">@r.Skill<div class="text-muted">@r.Domain</div></td>
                            <td><span class="pill pill-@r.Difficulty">@r.Difficulty</span></td>
                            <td class="small">@r.Given @(r.TimesWrong > 1 ? $"(wrong {r.TimesWrong}×)" : "")</td>
                            <td class="small text-nowrap">
                                @if (r.ReviewDue is DateTime due)
                                {
                                    @(due <= DateTime.UtcNow ? "Due now" : due.ToLocalTime().ToString("ddd d MMM"))
                                }
                            </td>
                            <td><a class="btn btn-sm btn-outline-primary" href="/Practice?q=@r.QuestionId&from=mistakes">Retry</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
