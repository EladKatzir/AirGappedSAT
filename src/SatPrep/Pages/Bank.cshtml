@page
@model BankModel
@{
    ViewData["Title"] = "Question bank";
}

<h1 class="h3 mb-1">Question bank</h1>
<p class="text-muted">Browse and open any question. Filter by skill, difficulty or what you've done with it.</p>

<form method="get" class="card p-3 mb-3">
    <div class="d-flex flex-wrap gap-2 filter-bar">
        <select class="form-select w-auto" name="skill" onchange="this.form.submit()">
            <option value="">All skills</option>
            @foreach (var g in Model.Skills.GroupBy(s => s.Domain!.Name))
            {
                <optgroup label="@g.Key">
                    @foreach (var s in g)
                    {
                        <option value="@s.Id" selected="@(Model.Skill == s.Id)">@s.Name</option>
                    }
                </optgroup>
            }
        </select>
        <select class="form-select w-auto" name="difficulty" onchange="this.form.submit()">
            <option value="">All difficulties</option>
            @foreach (var d in Enum.GetValues<Difficulty>())
            {
                <option selected="@(Model.Difficulty == d)">@d</option>
            }
        </select>
        <select class="form-select w-auto" name="status" onchange="this.form.submit()">
            <option value="">Any status</option>
            <option value="unseen" selected="@(Model.Status == "unseen")">Not tried</option>
            <option value="correct" selected="@(Model.Status == "correct")">Got right</option>
            <option value="incorrect" selected="@(Model.Status == "incorrect")">Got wrong</option>
            <option value="marked" selected="@(Model.Status == "marked")">Marked</option>
        </select>
        <input class="form-control w-auto" name="search" value="@Model.Search" placeholder="Search text" />
        <button class="btn btn-outline-primary" type="submit">Filter</button>
        <span class="ms-auto align-self-center small text-muted">@Model.Total questions</span>
    </div>
</form>

<div class="card p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Question</th><th>Skill</th><th></th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="small" style="max-width:460px">@r.Preview</td>
                        <td class="small">@r.Skill</td>
                        <td><span class="pill pill-@r.Difficulty">@r.Difficulty</span></td>
                        <td class="small">
                            @switch (r.Status)
                            {
                                case "correct": <span class="text-success">✓ right</span> break;
                                case "incorrect": <span class="text-danger">✗ wrong</span> break;
                                case "marked": <span class="text-warning">★ marked</span> break;
                                default: <span class="text-muted">–</span> break;
                            }
                        </td>
                        <td><a class="btn btn-sm btn-outline-primary" href="/Practice?q=@r.Id&from=bank">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Pages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm flex-wrap">
            @for (int i = 1; i <= Model.Pages; i++)
            {
                <li class="page-item @(i == Model.PageNo ? "active" : "")"><a class="page-link" href="@Model.PageUrl(i)">@i</a></li>
            }
        </ul>
    </nav>
}
