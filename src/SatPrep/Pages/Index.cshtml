@page
@model IndexModel
@{
    ViewData["Title"] = "Skill map";
}

<h1 class="h3 mb-1">SAT skill map</h1>
<p class="text-muted">@Model.TotalQuestions questions loaded. Practice, tests and mastery tracking are built on this map.</p>

@foreach (var section in Model.Domains.GroupBy(d => d.Section))
{
    <h2 class="h5 mt-4">@(section.Key == SatPrep.Models.SatSection.Math ? "Math" : "Reading and Writing")</h2>
    @foreach (var domain in section)
    {
        <table class="table table-sm align-middle mb-3">
            <thead>
                <tr>
                    <th>@domain.Name</th>
                    <th class="text-end" style="width:6rem">Easy</th>
                    <th class="text-end" style="width:6rem">Medium</th>
                    <th class="text-end" style="width:6rem">Hard</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in domain.Skills)
                {
                    <tr>
                        <td>@s.Name <span class="text-muted small">@s.Code</span></td>
                        <td class="text-end">@s.Easy</td>
                        <td class="text-end">@s.Medium</td>
                        <td class="text-end">@s.Hard</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
